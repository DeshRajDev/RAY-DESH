# Frontend Environment Configuration
# URL pointing to the Express & MongoDB backend API
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Optional: Static VAPID Public Key fallback (Must match backend VAPID_PUBLIC_KEY)
# Primary source of truth is dynamically fetched from GET /api/v1/notifications/vapid-public-key
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
